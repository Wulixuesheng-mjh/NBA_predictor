# ── Historical injury importer (one-off) ─────────────────
# Extends the base Python image with Java (JRE) so `tabula-py` (and therefore
# the `nbainjuries` package) can parse the NBA official injury report PDFs.
#
# Build from project root:
#   docker build -f ml/Dockerfile.injuries -t nba-injury-importer .
#
# Run (one-off, on nba-network, against postgres):
#   docker run --rm --network nba-network \
#     -e DATABASE_URL=postgresql+asyncpg://nba_admin:nba_predictor_2024@postgres:5432/nba_predictor \
#     nba-injury-importer [--start 2021-10-15] [--end 2026-06-15]

FROM python:3.12-slim

WORKDIR /app

# Java JRE for tabula-py + libpq for asyncpg
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-jre-headless \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Use Tsinghua mirror for faster downloads in China ─────
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Python deps: nbainjuries (pulls pandas/PyPDF2/requests) + tabula-py (Java),
# plus asyncpg + sqlalchemy + pydantic-settings for DB writes via app.models.
RUN pip install --no-cache-dir --no-compile --default-timeout=600 --retries 5 \
    pandas numpy requests PyPDF2 tabula-py nbainjuries \
    asyncpg "sqlalchemy[asyncio]" pydantic-settings

# Backend ORM models + config (mirrors the trainer image layout:
#   /app/backend/app contains the `app` package).
COPY backend/app/ ./backend/app/

# Import script
COPY scripts/import_historical_injuries.py ./scripts/

ENTRYPOINT ["python", "scripts/import_historical_injuries.py"]
