# ──────────────────────────────────────────────────────────
# NBA Predictor — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Generate secure passwords with:
#   openssl rand -base64 24
# ──────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────
# CHANGE the password in production!
DB_NAME=nba_predictor
DB_USER=nba_admin
DB_PASSWORD=change_me_in_production
DB_PORT=5432

# ── Backend ─────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Scheduler ───────────────────────────────────────────
SCHEDULER_ENABLED=true
COLLECTION_INTERVAL_MINUTES=360

# ── NBA API ─────────────────────────────────────────────
NBA_API_TIMEOUT=30

# ── BallDontLie Real-Time API ───────────────────────────
# Free key from https://app.balldontlie.io
BALLDONTLIE_API_KEY=
BALLDONTLIE_INTERVAL_MINUTES=30

# ── Security ────────────────────────────────────────────
# Admin API key for protected endpoints (/api/v1/admin/*)
# Generate: openssl rand -hex 16
# Leave empty to disable auth (development only!)
ADMIN_API_KEY=

# ── Model ───────────────────────────────────────────────
MODEL_PATH=../ml/saved_models

# ── App ─────────────────────────────────────────────────
DEBUG=false

# ── ML Trainer (for docker compose --profile trainer) ───
# TRAINER_ARGS=--seasons 2025-26 --lookback 10
